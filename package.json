{
  "name": "spectromind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-services.js && next dev",
    "dev:next": "next dev",
    "dev:services": "node scripts/start-services.js",
    "stop:services": "node scripts/stop-services.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke:library": "node Spectrotester/scripts/run_smoke_tests.mjs",
    "build:spectrotester": "tsc -p Spectrotester/tsconfig.json",
    "smoke:core": "node Spectrotester/scripts/run_core_smoke.mjs",
    "smoke:golden": "node Spectrotester/scripts/run_golden_smoke.mjs",
    "smoke:forbidden": "node Spectrotester/scripts/run_forbidden_state_gate.mjs",
    "telemetry:governance": "node Spectrotester/scripts/emit_governance_telemetry.mjs",
    "incident:tests:generate": "node Spectrotester/scripts/generate_tests_from_incidents.mjs",
    "phase3:gate": "npm run build:spectrotester && npm run smoke:core && npm run smoke:golden && node Spectrotester/scripts/run_axis_parity_smoke.mjs && node Spectrotester/scripts/run_observed_qc_analyze_smoke.mjs && npm run smoke:forbidden",
    "phase3:governance": "npm run phase3:gate && npm run telemetry:governance && npm run incident:tests:generate",
    "phase4:tune-triggers": "node Spectrotester/scripts/tune_triggers_from_telemetry.mjs",
    "phase4:optimize-pairings": "node Spectrotester/scripts/optimize_subagent_pairings.mjs",
    "phase4:update-memory": "node Spectrotester/scripts/update_failure_memory.mjs",
    "phase4:validate-output": "node Spectrotester/scripts/validate_orchestrator_outputs.mjs",
    "phase4:cycle": "node Spectrotester/scripts/run_orchestrator_phase4_cycle.mjs",
    "phase4:continuity": "npm run phase3:governance && npm run phase4:cycle",
    "doc:spectrotester": "node scripts/generate-spectrotester-docx.js",
    "doc:synthesis-arch": "node scripts/generate-organic-synthesis-knowledge-architecture-docx.js",
    "doc:spectromind-system": "node scripts/generate-spectromind-system-documentation-docx.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@react-three/drei": "^9.88.0",
    "@react-three/fiber": "^8.18.0",
    "3dmol": "^2.5.3",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "crypto-js": "^4.2.0",
    "hammerjs": "^2.0.8",
    "ioredis": "^5.10.1",
    "jszip": "^3.10.1",
    "marked": "^17.0.1",
    "next": "16.0.8",
    "openai": "^6.14.0",
    "pyodide": "^0.24.1",
    "react": "19.2.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.1",
    "react-dropzone": "^15.0.0",
    "react-resizable-panels": "^3.0.6",
    "three": "^0.155.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.155.0",
    "@vitest/coverage-v8": "^4.1.2",
    "docx": "^9.5.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "react": "19.2.1",
    "react-dom": "19.2.1"
  }
}
