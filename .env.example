# SpectroMind Environment Variables
# Copy this file to .env.local for development

# Node Environment
NODE_ENV=production

# Next.js Configuration
NEXT_PUBLIC_APP_URL=https://spectromind.app

# API Keys (These should be set in user's browser localStorage, not server-side)
# NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
# NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Security
# NEXTAUTH_SECRET=your_nextauth_secret_here (if using authentication)

# Performance
NEXT_TELEMETRY_DISABLED=1
