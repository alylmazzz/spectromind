{
  "schema_version": "1.0.0",
  "rules": [
    {
      "id": "TRIGGER_AUTHORITY_DRIFT_ESCALATION",
      "condition": "authority_integrity_score < authority_integrity_min",
      "activate": [
        "spectromind-subagent-orchestrator",
        "spectrotester-rule-engine-architect",
        "spectromind-regression-guardian"
      ]
    },
    {
      "id": "TRIGGER_PARITY_DRIFT_ESCALATION",
      "condition": "parity_drift_index > parity_drift_index_max",
      "activate": [
        "spectromind-chart-parity-architect",
        "spectromind-subagent-orchestrator"
      ]
    },
    {
      "id": "TRIGGER_VERDICT_CEILING_ESCALATION",
      "condition": "verdict_ceiling_triggered == true",
      "activate": [
        "spectrotester-rule-engine-architect",
        "spectromind-regression-guardian"
      ]
    }
  ]
}
