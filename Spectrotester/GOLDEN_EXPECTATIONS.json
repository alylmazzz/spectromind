  "mandatory_regression_set_v1": {
    "description": "Release-blocking golden regression set for solvent effects, overlap safety, class recognition, and parity invariance.",
    "authority_contract": "All cases must preserve authoritative-observed-first behavior; helper/fallback must remain display-only and never affect peak table, integrals, scoring, or verdict.",
    "required_cases": [
      {
        "id": "chitosan_acidic_solvent_case",
        "priority": "BLOCKER",
        "type": "solvent_sensitive",
        "target": {
          "name": "Chitosan acidic solvent case",
          "smiles_or_material": "poly(2-amino-2-deoxy-D-glucose), protonated in acidic solvent"
        },
        "invariants": {
          "provenance": {
            "authoritative_tier_required": true,
            "helper_must_not_drive_science": true
          },
          "h1": {
            "exchangeable_pool_must_be_explicit": true,
            "solvent_masking_must_be_auditable": true
          },
          "forbidden_states": [
            "helper_toggle_changes_authoritative_peak_table",
            "helper_toggle_changes_integrals"
          ]
        }
      },
      {
        "id": "pyridine_chloroform_dcm_overlaps",
        "priority": "BLOCKER",
        "type": "overlap_stress",
        "target": {
          "name": "Pyridine/chloroform/DCM overlap set",
          "components": ["pyridine", "chloroform", "dichloromethane"]
        },
        "invariants": {
          "h1": {
            "overlap_region_protection_required": true,
            "adaptive_noise_thresholding_required": true,
            "unresolved_multiplet_state_allowed": true
          },
          "forbidden_states": [
            "overfragmented_fake_repeated_unresolved_peaks",
            "solvent_overlap_inflates_confidence"
          ]
        }
      },
      {
        "id": "benzoic_false_positive_prevention",
        "priority": "BLOCKER",
        "type": "false_positive_guard",
        "target": {
          "name": "Benzoic acid false-positive prevention",
          "smiles": "OC(=O)c1ccccc1"
        },
        "invariants": {
          "formula_consensus_required": true,
          "graph_first_subtype_required": true,
          "qc": {
            "acid_ester_confusion_must_not_pass": true,
            "metadata_only_rules_must_not_inflate_verdict": true
          },
          "forbidden_states": [
            "acid_reported_as_ester",
            "strong_validated_with_subtype_conflict"
          ]
        }
      },
      {
        "id": "oleanolic_class_recognition",
        "priority": "BLOCKER",
        "type": "class_recognition",
        "target": {
          "name": "Oleanolic acid class recognition",
          "smiles": "CC1(C)CCC2(C(=CCC3C2CCC4(C3(CCC(C4)OC(=O)C)C)C)C)C(=O)O"
        },
        "invariants": {
          "c13": {
            "triterpenoid_class_signal_distribution_required": true,
            "carbonyl_presence_required": true
          },
          "rule_engine": {
            "class_consistency_required": true,
            "confidence_cap_on_formula_mismatch": true
          },
          "forbidden_states": [
            "class_drift_to_generic_aliphatic_only",
            "verdict_inflation_without_authoritative_2d"
          ]
        }
      },
      {
        "id": "parity_invariance",
        "priority": "BLOCKER",
        "type": "parity_contract",
        "target": {
          "name": "Mnova parity invariance",
          "scope": "before_after_processing_and_chart"
        },
        "invariants": {
          "snapshot_required": [
            "ppm_axis_referenced",
            "peak_regions",
            "verdict_json",
            "helper_contamination_status",
            "chart_domain_source",
            "scale_mode_source"
          ],
          "domains": {
            "h1_default": [14.0, -1.0],
            "c13_default": [230.0, -10.0]
          },
          "forbidden_states": [
            "silent_axis_fallback_claimed_as_authoritative",
            "helper_affects_domain_or_scale"
          ]
        }
      }
    ]
