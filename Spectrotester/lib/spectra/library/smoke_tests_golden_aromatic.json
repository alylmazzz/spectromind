{
  "rule_id": "GOLDEN_AROMATIC_CARBONYL_FORMULA",
  "description": "Resveratrol, Quercetin, Catechin: formula, DBE, aromatic, carbonyl from MoleculeGraph (RDKit). NO REGEX.",
  "test_cases": [
    {
      "id": "resveratrol",
      "smiles": "C=C(/C1=CC=C(C=C1)O)\\C2=CC(=CC(=C2)O)O",
      "expected_formula": "C14H12O3",
      "expected_dbe": 9,
      "expected_aromatic_c_min": 12,
      "expected_carbonyl": false,
      "expected_aromatic_13c_ppm_range": [110, 160]
    },
    {
      "id": "quercetin",
      "smiles": "O=c1c(O)c(-c2ccc(O)c(O)c2)oc2cc(O)cc(O)c12",
      "expected_formula": "C15H10O7",
      "expected_dbe": 11,
      "expected_aromatic_c_min": 10,
      "expected_carbonyl": true,
      "expected_carbonyl_ppm_range": [160, 190]
    },
    {
      "id": "catechin",
      "smiles": "C1C(C(OC2=CC(=CC(=C21)O)O)C3=CC(=C(C=C3)O)O)O",
      "expected_formula": "C15H14O6",
      "expected_dbe": 9,
      "expected_aromatic_c_min": 12,
      "expected_carbonyl": false,
      "expected_aromatic_13c_ppm_range": [110, 160]
    }
  ],
  "how_to_run": "node Spectrotester/scripts/run_golden_smoke.mjs (requires parse_and_standardize API or RDKit)"
}
