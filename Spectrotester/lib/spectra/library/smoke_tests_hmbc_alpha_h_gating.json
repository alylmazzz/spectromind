{
  "schema_version": "1.0",
  "rule_id": "HMBC_CARBONYL_REQUIRED_ONLY_IF_PATH_EXISTS",
  "description": "Alpha-H path gating: HMBC carbonyl correlation required only when structure has alpha H to carbonyl (ester/ketone/amide/aldehyde). Acid-only (COOH) has no alpha C–H; HMBC optional.",
  "test_cases": [
    {
      "id": "ST-001",
      "smiles": "CC(=O)O",
      "expected_has_alpha_h_for_carbonyl": false,
      "expected_hmbc_carbonyl_required": false,
      "description": "Acetic acid only – no alpha C–H to carbonyl; HMBC carbonyl not required."
    },
    {
      "id": "ST-002",
      "smiles": "C(F)(F)(F)C(=O)O",
      "expected_has_alpha_h_for_carbonyl": false,
      "expected_hmbc_carbonyl_required": false,
      "description": "TFA – trifluoroacetic acid; carbonyl alpha position has F, no H; HMBC optional."
    },
    {
      "id": "ST-003",
      "smiles": "CC(=O)OC",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "Methyl acetate (ester) – alpha CH3; HMBC carbonyl required."
    },
    {
      "id": "ST-004",
      "smiles": "CCOC(=O)C",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "Ethyl acetate – ester with alpha CH2/CH3; HMBC required."
    },
    {
      "id": "ST-005",
      "smiles": "CC(=O)C",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "Acetone – ketone with alpha CH3; HMBC carbonyl required."
    },
    {
      "id": "ST-006",
      "smiles": "CC(=O)N",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "Acetamide – amide with alpha CH3; HMBC required."
    },
    {
      "id": "ST-007",
      "smiles": "CC=O",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "Acetaldehyde – aldehyde CHO; alpha H present; HMBC required."
    },
    {
      "id": "ST-008",
      "smiles": "CC#N",
      "expected_has_alpha_h_for_carbonyl": false,
      "expected_hmbc_carbonyl_required": false,
      "description": "Acetonitrile – no carbonyl; HMBC nitrile optional."
    },
    {
      "id": "ST-009",
      "smiles": "CC(=O)OCC",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "Ethyl acetate – ester; HMBC required."
    },
    {
      "id": "ST-010",
      "smiles": "C1CCCCC1",
      "expected_has_alpha_h_for_carbonyl": false,
      "expected_hmbc_carbonyl_required": false,
      "description": "Cyclohexane – no carbonyl; no HMBC carbonyl requirement."
    },
    {
      "id": "ST-011",
      "smiles": "c1ccccc1C(=O)O",
      "expected_has_alpha_h_for_carbonyl": false,
      "expected_hmbc_carbonyl_required": false,
      "description": "Benzoic acid – acid only; no alpha C–H to C=O; HMBC optional."
    },
    {
      "id": "ST-012",
      "smiles": "c1ccccc1C(=O)OC",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "Methyl benzoate – ester; alpha O-CH3; HMBC required."
    },
    {
      "id": "ST-013",
      "smiles": "C(F)(F)C(=O)O",
      "expected_has_alpha_h_for_carbonyl": false,
      "expected_hmbc_carbonyl_required": false,
      "description": "Difluoroacetic acid – alpha CF2; no alpha H; HMBC optional."
    },
    {
      "id": "ST-014",
      "smiles": "CC(=O)N(C)C",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "N,N-Dimethylacetamide – amide with alpha CH3; HMBC required."
    },
    {
      "id": "ST-015",
      "smiles": "CCO",
      "expected_has_alpha_h_for_carbonyl": false,
      "expected_hmbc_carbonyl_required": false,
      "description": "Ethanol – no carbonyl; no HMBC carbonyl requirement."
    },
    {
      "id": "ST-016",
      "smiles": "c1ccccc1",
      "expected_has_alpha_h_for_carbonyl": false,
      "expected_hmbc_carbonyl_required": false,
      "description": "Benzene – no carbonyl; required=false."
    },
    {
      "id": "ST-017",
      "smiles": "O=CO",
      "expected_has_alpha_h_for_carbonyl": false,
      "expected_hmbc_carbonyl_required": false,
      "description": "Formic acid – no alpha C–H to carbonyl; HMBC optional."
    },
    {
      "id": "ST-018",
      "smiles": "c1ccccc1C=O",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "Benzaldehyde – formyl H; HMBC required."
    },
    {
      "id": "ST-019",
      "smiles": "CC(=O)NC",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "N-Methylacetamide – alpha CH3; HMBC required."
    },
    {
      "id": "ST-020",
      "smiles": "CCOC(=O)c1ccccc1",
      "expected_has_alpha_h_for_carbonyl": true,
      "expected_hmbc_carbonyl_required": true,
      "description": "Ethyl benzoate – ester alpha CH2; HMBC required."
    }
  ],
  "how_to_run": "Load Spectromasterv0.2tester.html; for each test case, create kernel from smiles, run generate* and runVerification; assert modules.hmbc.hasAlphaHForCarbonyl === expected_has_alpha_h_for_carbonyl and (hmbc carbonyl WARN only when expected_hmbc_carbonyl_required && hmbcToCarbonyl.length === 0)."
}
