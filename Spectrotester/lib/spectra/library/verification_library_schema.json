{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SPECTRAL VERIFICATION LIBRARY",
  "description": "Teyit motoru referans verisi: functional_group_shift_priors, J_coupling_priors, IR_band_priors, MS_adduct_rules, solvent_impurity_catalog, isotope_rules",
  "type": "object",
  "properties": {
    "functional_group_shift_priors": {
      "type": "object",
      "properties": {
        "h1": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "context": { "type": "string" } }
          }
        },
        "c13": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "context": { "type": "string" } }
          }
        }
      }
    },
    "J_coupling_priors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "unit": { "type": "string" }, "note": { "type": "string" } }
      }
    },
    "IR_band_priors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "intensity": { "type": "string" } }
      }
    },
    "MS_adduct_rules": {
      "type": "object",
      "properties": {
        "positive": { "type": "array", "items": { "type": "object", "properties": { "label": { "type": "string" }, "massDelta": { "type": "number" }, "name": { "type": "string" } } } },
        "negative": { "type": "array", "items": { "type": "object" } }
      }
    },
    "solvent_impurity_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" }, "ppm_1h": { "type": "number" }, "pattern": { "type": "string" }, "note": { "type": "string" } }
      }
    },
    "isotope_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": { "M2_ratio_min": { "type": "number" }, "M2_ratio_max": { "type": "number" }, "per_atom": { "type": "boolean" } }
      }
    },
    "peakshape_priors": { "type": "object", "description": "Lorentz/Gauss/Voigt; linewidth aralıkları", "additionalProperties": true },
    "solvent_shift_offsets": { "type": "object", "description": "DMSO/CDCl3 sistematik kaymalar", "additionalProperties": true },
    "noise_model_priors": { "type": "object", "description": "low_snr senaryosu", "additionalProperties": true },
    "fragmentation_rules_ms": { "type": "object", "description": "Temel frag motifleri", "additionalProperties": true },
    "2d_expected_connectivity_priors": { "type": "object", "description": "HSQC/HMBC beklenen bağ mesafeleri", "additionalProperties": true }
  }
}
