{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spectromind.local/schemas/rule_schema.json",
  "title": "Rule Definition Schema (Extended)",
  "description": "Teyit motoru kural tanımı. Ürün yönetimi: rule_version, applies_to_engines, confidence_impact, references, autofix + scoring, skip_policy, threshold_profiles, evidence_rules, explain_template, debug_trace, unit_tests. Backward-compatible.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "rule_id": { "type": "string", "description": "Benzersiz kural tanımlayıcı", "minLength": 5, "maxLength": 128 },
    "modality": { "type": "string", "enum": ["1H", "13C", "HSQC", "COSY", "HMBC", "NOESY", "DEPT", "APT", "MS", "FT-IR", "FORMULA", "GLOBAL", "OBSERVED_QC"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "prerequisites": { "type": "array", "items": { "type": "string" }, "minItems": 0 },
    "prerequisites_detail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "key": { "type": "string" }, "source": { "type": "string" }, "critical": { "type": "boolean" }, "notes": { "type": "string" } },
        "required": ["key"]
      }
    },
    "hardness": { "type": "string", "enum": ["HARD", "SOFT", "INFO"] },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
    "status_on_fail": { "type": "string", "enum": ["FAIL", "ERROR", "FATAL", "WARN", "INFO", "INCONCLUSIVE"], "default": "FAIL" },
    "status_on_skip": { "type": "string", "enum": ["SKIP", "NOT_APPLICABLE", "INCONCLUSIVE", "INFO"], "default": "SKIP" },
    "skip_policy": {
      "type": "object",
      "properties": {
        "if_missing_prereq": { "type": "string", "enum": ["SKIP", "INCONCLUSIVE", "ERROR"], "default": "SKIP" },
        "if_modality_absent": { "type": "string", "enum": ["SKIP", "INCONCLUSIVE"], "default": "SKIP" },
        "if_kernel_confidence_low": { "type": "string", "enum": ["SKIP", "WARN", "INCONCLUSIVE"], "default": "INCONCLUSIVE" },
        "notes": { "type": "string" }
      }
    },
    "thresholds": { "type": "object", "additionalProperties": true, "default": {} },
    "threshold_overrides_by_profile": {
      "type": "object",
      "additionalProperties": { "type": "object", "additionalProperties": true },
      "properties": { "lowSNR": {}, "normal": {}, "highRes": {} }
    },
    "threshold_units": { "type": "object", "additionalProperties": { "type": "string" } },
    "evidence_minimum": { "type": "string" },
    "evidence_capture": { "type": "array", "items": { "type": "string" }, "minItems": 0 },
    "evidence_rules": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
    "why_narrative": { "type": "string", "maxLength": 3000 },
    "suggested_action": { "type": "string", "maxLength": 2000 },
    "failure_modes": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
    "severity_model": {
      "type": "object",
      "properties": {
        "fail_to": { "type": "string", "enum": ["WARN", "ERROR", "FATAL", "INCONCLUSIVE"] },
        "warn_to": { "type": "string", "enum": ["INFO", "WARN"] },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "when": { "type": "string" }, "set_status": { "type": "string" }, "note": { "type": "string" } },
            "required": ["when", "set_status"]
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "weight": { "type": "number", "minimum": 0, "maximum": 5, "default": 1.0 },
        "on_pass": { "type": "object", "properties": { "delta_score": { "type": "number" }, "delta_confidence": { "type": "number" } } },
        "on_fail": { "type": "object", "properties": { "delta_score": { "type": "number" }, "delta_confidence": { "type": "number" } } },
        "on_skip": { "type": "object", "properties": { "delta_score": { "type": "number" }, "delta_confidence": { "type": "number" } } }
      }
    },
    "confidence_impact": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
    "rule_version": { "type": "string", "default": "1.0.0" },
    "applies_to_engines": { "type": "array", "items": { "type": "string", "enum": ["spectromind", "spectrotester", "hybrid"] }, "minItems": 0 },
    "applicability": {
      "type": "object",
      "properties": {
        "requires_modalities": { "type": "array", "items": { "type": "string" } },
        "solvents": { "type": "array", "items": { "type": "string" } },
        "field_mhz_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "only_if": { "type": "string" },
        "exclude_if": { "type": "string" }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "type": { "type": "string", "enum": ["doi", "url", "text"] }, "value": { "type": "string" } },
        "required": ["type", "value"]
      }
    },
    "autofix": {
      "type": ["object", "null"],
      "properties": {
        "patch_type": { "type": "string" },
        "patch_hint": { "type": "string" },
        "safe": { "type": "boolean", "default": true },
        "requires_user_confirmation": { "type": "boolean", "default": false }
      }
    },
    "authority_scope": { "type": "string", "enum": ["OBSERVED_ONLY", "AUTHORITATIVE", "ANY"] },
    "fallback_policy": { "type": "string", "enum": ["IGNORE", "NOTE_ONLY", "DOWNGRADE", "BLOCK"] },
    "modality_required": { "type": "boolean" },
    "metadata_required": { "type": "array", "items": { "type": "string" } },
    "root_cause_class": { "type": "string", "enum": ["DATA_MISSING", "PROVENANCE_ERROR", "SCIENTIFIC_CONFLICT", "THRESHOLD_FRICTION", "LIBRARY_GAP"] },
    "autofix_patch_type": { "type": "string" },
    "audit_trace_fields": { "type": "array", "items": { "type": "string" } },
    "explain_template": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "bullets": { "type": "array", "items": { "type": "string" } },
        "details": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audit_tags": { "type": "array", "items": { "type": "string" } },
    "debug_trace_keys": { "type": "array", "items": { "type": "string" } },
    "governance": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "deprecated", "experimental"], "default": "active" },
        "deprecation_note": { "type": "string" },
        "risk_level": { "type": "string", "enum": ["low", "medium", "high"], "default": "low" }
      }
    },
    "unit_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "smiles": { "type": "string" },
          "profile": { "type": "string", "enum": ["lowSNR", "normal", "highRes"] },
          "expect_status": { "type": "string", "enum": ["PASS", "WARN", "ERROR", "FATAL", "INCONCLUSIVE", "SKIP", "INFO"] },
          "expect": { "type": "string" },
          "notes": { "type": "string" }
        },
        "required": ["name"]
      }
    }
  },
  "required": ["rule_id", "hardness"]
}
